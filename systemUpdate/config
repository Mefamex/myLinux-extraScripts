# systemUpdate — settings (tracked in git)
# Precedence: env > this file > built-in defaults

# Log directory (empty = auto: xdg-user-dir DOCUMENTS → ~/systemUpdate → ~/.local/state/systemUpdate)
LOG_DIR="$HOME/Belgeler/systemUpdate"

# How many log files to keep
LOG_KEEP=50

# Channels to never ask about (space-separated)
# Valid: npm code pipx uv opencode claude codex pnpm pip go cargo docker flatpak dotnet composer gh
SKIP_CHANNELS=""

# Where go install puts binaries
GO_BIN_DIR="$HOME/go/bin"

# Also query AUR in --status (1 = yes, needs network)
STATUS_AUR=0