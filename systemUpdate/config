# systemUpdate — settings (tracked in git, all commented = defaults)
# Precedence: env > this file > built-in defaults
# Uncomment to change. For personal-only values, use env instead.

# LOG_DIR — log directory (empty = auto cascade: Belgeler/ → Documents/ → ~/systemUpdate/ → ~/.local/state/systemUpdate)
#LOG_DIR=""

# LOG_KEEP — how many log files to keep (non-numeric = keep all, typo-safe)
#LOG_KEEP=50

# SKIP_CHANNELS — never ask about these (space-separated)
# Valid: npm code pipx uv opencode claude codex pnpm pip go cargo docker flatpak dotnet composer gh
#SKIP_CHANNELS=""

# GO_BIN_DIR — where go install puts binaries
#GO_BIN_DIR="$HOME/go/bin"

# STATUS_AUR — also query AUR in --status (1 = yes, needs network)
#STATUS_AUR=0